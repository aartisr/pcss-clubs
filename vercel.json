{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "redirects": [
    {
      "source": "/campus/:campusSlug/clubs/:clubSlug",
      "destination": "/sites/:campusSlug/:clubSlug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/credits", "destination": "/credits/index.html" },
    { "source": "/credits/", "destination": "/credits/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms/", "destination": "/terms/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/support/", "destination": "/support/index.html" },
    { "source": "/campus/:campusSlug", "destination": "/campus/:campusSlug/index.html" },
    { "source": "/campus/:campusSlug/", "destination": "/campus/:campusSlug/index.html" },
    { "source": "/sites/:campusSlug/:clubSlug", "destination": "/sites/:campusSlug/:clubSlug/index.html" },
    { "source": "/sites/:campusSlug/:clubSlug/", "destination": "/sites/:campusSlug/:clubSlug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/editor/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/my",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/my/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/editor",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
