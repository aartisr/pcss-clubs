# Register this callback with your OIDC provider: ${OIDC_APP_ORIGIN}/api/auth/callback
OIDC_ISSUER=https://identity.example.edu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Choose post (default) or basic to match the provider's token endpoint.
# OIDC_CLIENT_AUTH_METHOD=basic
OIDC_APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OIDC_SESSION_SECRET=
# Choose one or both allowlists. Subject is the provider's stable user ID.
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_EMAILS=
# For Google Workspace, require the signed hd claim to match your school domain.
# OIDC_REQUIRED_HOSTED_DOMAIN=pioneercss.org
# Only for a provider where every account is an approved editor:
# OIDC_EDIT_POLICY=authenticated

# Public project-stage notice (default: both). Set to off after approval and launch.
# Values: both, approval, development, off
VITE_SITE_REVIEW_STATUS=both
